<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:layout_marginVertical="4dp"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_dep_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="Fabric API"
        android:textColor="@color/xm_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_dep_status"
        app:layout_constraintEnd_toStartOf="@+id/btn_dep_download"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_dep_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:text="Status: Missing (Required for this mod)"
        android:textColor="@color/xm_text_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_dep_download"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dep_name" />

    <!-- Manual Download Button for Dependency -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dep_download"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="DOWNLOAD"
        android:textColor="@color/xm_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:backgroundTint="@color/xm_primary"
        app:cornerRadius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
