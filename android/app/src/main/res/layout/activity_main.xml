<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xm_background"
    android:padding="20dp">

    <!-- Left Column: Branding & Launch -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_glass"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/panel_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45">

        <!-- Logo & Title -->
        <TextView
            android:id="@+id/tv_brand_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XM"
            android:textColor="@color/xm_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_brand_client"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="CLIENT"
            android:textColor="@color/xm_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_brand_logo"
            app:layout_constraintStart_toEndOf="@+id/tv_brand_logo"
            app:layout_constraintTop_toTopOf="@+id/tv_brand_logo" />

        <TextView
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BY MAYANK MANDRAI • MOBILE EDITION"
            android:textColor="@color/xm_text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_brand_logo" />

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/card_memory_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#27272A"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_author">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIKAR G1GC ENGINE: ACTIVE"
                android:textColor="@color/xm_primary_glow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_allocated_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Allocated RAM: 3072 MB"
                android:textColor="@color/xm_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Big Launch Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_launch"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_crimson"
            android:text="LAUNCH GAME"
            android:textColor="@color/xm_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right Column: Version / Loader Lock & Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_card_glass"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/panel_left"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME PROFILES (LOCKED VERSIONS)"
            android:textColor="@color/xm_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Minecraft Version Selector (Strictly 1.21.1 and 1.20.1) -->
        <LinearLayout
            android:id="@+id/layout_versions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_section_title">

            <Button
                android:id="@+id/btn_ver_1_21_1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_crimson"
                android:text="1.21.1 (Fabric/Neo)"
                android:textColor="@color/xm_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_ver_1_20_1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#27272A"
                android:text="1.20.1 (Fabric/Neo)"
                android:textColor="@color/xm_text_secondary"
                android:textSize="13sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Mod Loader Selector (Strictly Fabric and NeoForge) -->
        <TextView
            android:id="@+id/tv_loader_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MOD LOADER (FABRIC / NEOFORGE)"
            android:textColor="@color/xm_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_versions" />

        <LinearLayout
            android:id="@+id/layout_loaders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_loader_title">

            <Button
                android:id="@+id/btn_loader_fabric"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_crimson"
                android:text="FABRIC"
                android:textColor="@color/xm_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_loader_neoforge"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#27272A"
                android:text="NEOFORGE"
                android:textColor="@color/xm_text_secondary"
                android:textSize="13sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Feature Modules Navigation -->
        <LinearLayout
            android:id="@+id/layout_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- XMods Store Button -->
            <Button
                android:id="@+id/btn_open_xmods"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#27272A"
                android:text="XMODS STORE\n(Modrinth + CurseForge)"
                android:textColor="@color/xm_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Virtual Controls Editor Button -->
            <Button
                android:id="@+id/btn_open_controls"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#27272A"
                android:text="CUSTOM CONTROLS\n(Edit / Add Buttons)"
                android:textColor="@color/xm_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
