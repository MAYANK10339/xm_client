<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD CUSTOM BUTTON"
        android:textColor="@color/xm_primary_glow"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Create a custom touch button and bind it to any keyboard or mouse key."
        android:textColor="@color/xm_text_secondary"
        android:textSize="12sp" />

    <!-- Button Label Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="BUTTON LABEL (Display Text):"
        android:textColor="@color/xm_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_button_label"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#27272A"
        android:hint="e.g. ZOOM, F3, MACRO, V"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="14dp"
        android:textColor="@color/xm_text_primary"
        android:textColorHint="@color/xm_text_muted"
        android:textSize="14sp" />

    <!-- Keycode Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="BIND TO MINECRAFT KEY (GLFW KEYCODE):"
        android:textColor="@color/xm_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinner_key_codes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#27272A"
        android:paddingHorizontal="10dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_add"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="#27272A"
            android:text="CANCEL"
            android:textColor="@color/xm_text_secondary"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_confirm_add"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_crimson"
            android:text="ADD BUTTON"
            android:textColor="@color/xm_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
