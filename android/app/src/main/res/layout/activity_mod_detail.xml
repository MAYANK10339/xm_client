<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xm_background"
    android:padding="20dp">

    <!-- Top Bar -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_glass"
        android:contentDescription="Back"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/xm_text_primary" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="MOD SPECIFICATION"
        android:textColor="@color/xm_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintStart_toEndOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="@+id/btn_back" />

    <!-- Left Details Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/xm_surface_card"
        app:cardCornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_dependencies"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        app:layout_constraintWidth_percent="0.48">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_detail_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Mod Icon"
                android:src="@mipmap/ic_launcher"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Sodium"
                android:textColor="@color/xm_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_detail_icon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_detail_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:text="Source: Modrinth • by jellysquid3_"
                android:textColor="@color/xm_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_detail_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_detail_name" />

            <TextView
                android:id="@+id/tv_detail_desc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:text="A modern rendering engine for Minecraft that greatly improves frame rates and reduces stutter."
                android:textColor="@color/xm_text_muted"
                android:textSize="13sp"
                app:layout_constraintBottom_toTopOf="@+id/btn_main_action"
                app:layout_constraintTop_toBottomOf="@+id/iv_detail_icon" />

            <!-- Main Install / Installed Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_main_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="INSTALL MOD"
                android:textColor="@color/xm_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/xm_primary"
                app:cornerRadius="10dp"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Right Dependencies Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_dependencies"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/xm_surface_card"
        app:cardCornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_details"
        app:layout_constraintTop_toBottomOf="@+id/btn_back">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_dep_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQUIRED DEPENDENCIES"
                android:textColor="@color/xm_primary_glow"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_dep_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Review dependencies below. You can download each manually if needed."
                android:textColor="@color/xm_text_secondary"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@+id/tv_dep_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dependencies"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_dep_sub"
                tools:listitem="@layout/item_dependency" />

            <TextView
                android:id="@+id/tv_no_deps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Zero dependencies required. Safe to install directly!"
                android:textColor="@color/xm_installed_green"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/progress_deps"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/xm_primary"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
